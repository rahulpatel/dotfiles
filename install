#!/usr/bin/env bash
# install - top-level orchestrator.
#
# Each file in modules/ is a tool/step. It defines functions named after the
# phases it participates in (prepare, install, configure, finish). The
# orchestrator iterates phases and, for each phase, runs that phase's
# function from every module that defines one.
#
# The MODULES array below is the single source of truth for which modules
# run and in what order. modules/_lib.sh is shared code, sourced separately,
# not listed here.
#
# Usage:
#   ./install                       # uses persisted PROFILE from .profile
#   PROFILE=work ./install          # selects/persists profile

set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")" && pwd)"
export DOTFILES

# shellcheck source=modules/_lib.sh
source "$DOTFILES/modules/_lib.sh"

# Resolve profile. Precedence: PROFILE env var > persisted .profile > fail.
if [ -n "${PROFILE:-}" ]; then
    echo "$PROFILE" > "$PROFILE_FILE"
elif [ -f "$PROFILE_FILE" ]; then
    PROFILE="$(cat "$PROFILE_FILE")"
else
    die "No profile selected. Run with PROFILE=<name> ./install (e.g. PROFILE=personal)."
fi
export PROFILE
[ -d "$DOTFILES/profiles/$PROFILE" ] || \
    die "Profile '$PROFILE' not found at $DOTFILES/profiles/$PROFILE"
log "Active profile: $PROFILE"

# Module pipeline, in execution order. Each name maps to modules/<name>.sh.
# Add new modules here; this list is the single source of truth for ordering.
MODULES=(
    xcode       # verify Xcode Command Line Tools
    sudo        # cache sudo credentials + keepalive
    homebrew    # install brew, then `brew bundle`
    stow        # symlink profile dotfiles into $HOME
    macos       # apply macOS defaults
    mise        # install language runtimes
    tmux        # install tpm + plugins
    killall     # restart Dock/Finder/etc.
    summary     # print completion message
)

PHASES=(prepare install configure finish)

for phase in "${PHASES[@]}"; do
    log "==> $phase"
    for name in "${MODULES[@]}"; do
        module="$DOTFILES/modules/$name.sh"
        [ -f "$module" ] || die "Module not found: $module"
        # Clear any phase functions left over from the previous module so we
        # only ever call the current module's function.
        unset -f prepare install configure finish 2>/dev/null || true
        # shellcheck source=/dev/null
        source "$module"
        if declare -f "$phase" >/dev/null; then
            log "  -> $name"
            "$phase"
        fi
    done
done
