[branch]
  sort = -committerdate    # Sort branches by most recent commit first

[commit]
  verbose = true           # Include diff comment in commit message template

[column]
  ui = auto                # Show columns in `git status`

[diff]
  algorithm = histogram    # Clearer diffs on moved/edited lines
  colorMoved = plain       # Highlight moved blocks in diffs
  mnemonicPrefix = true    # More intuitive refs in diff output

[init]
  defaultBranch = main

[pull]
  rebase = true            # Use rebase instead of merge when pulling

[push]
  autoSetupRemote = true   # Automatically set upstream branch on push

[rebase]
  autoStash = true         # Automatically stash before rebasing
  updateRefs = true        # Update local refs after rebasing

[rerere]
  enabled = true           # Record and reuse conflict resolutions
  autoupdate = true        # Apply stored conflict resolutions automatically

[tag]
  sort = -version:refname  # Sort version numbers as you would expect

[user]
  name = Rahul Patel
  email = rahulpatel@users.noreply.github.com

# Machine-local overrides (not committed). Restored out-of-band per machine.
# Put work routing and identity here so employer details never enter the repo:
#
#   [includeIf "hasconfig:remote.*.url:git@github.com:<employer-org>/**"]
#       path = ~/.gitconfig.work
#   [includeIf "gitdir:~/work/"]
#       path = ~/.gitconfig.work
#
# ...and keep the work identity itself in ~/.gitconfig.work, also out-of-band.
[include]
	path = ~/.gitconfig.local

