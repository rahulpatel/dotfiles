#!/usr/bin/env bash
# window-icon <name> -> prints a Nerd Font glyph matching <name>, or a
# fallback. Designed to be invoked from tmux via #(...).
#
# Lookup table is glyphnames.tsv (name<TAB>char) next to this script,
# generated from nerd-fonts' glyphnames.json. Tries the name as-is first,
# then several common prefixes (dev-, seti-, md-, fa-, cod-, custom-).
# Results are cached per-name under $XDG_CACHE_HOME so the tmux status
# redraw stays cheap.
set -eu

name="${1:-}"
db="$HOME/.config/tmux/glyphnames.tsv"
aliases="$HOME/.config/tmux/glyphaliases.tsv"
# Fallback glyph (md-console 󰆍) written as raw bytes so file-encoding
# round-trips don't strip it.
fallback="$(printf '\xf3\xb0\x86\x8d')"

if [ -z "$name" ] || [ ! -f "$db" ]; then
    printf '%s' "$fallback"
    exit 0
fi

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-icons"
mkdir -p "$cache_dir"
# Sanitize name for use as a filename.
safe="$(printf '%s' "$name" | tr -c '[:alnum:]._-' '_')"
cache="$cache_dir/$safe"

# Reuse cached result unless the lookup table is newer.
if [ -f "$cache" ] && [ ! "$db" -nt "$cache" ]; then
    cat "$cache"
    exit 0
fi

lc="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"

# 1) Alias lookup: user-mapped name -> canonical glyph name. If the
#    alias resolves to a full glyph name (contains a "-"), use it as-is;
#    otherwise treat it as a new bare name to feed through the prefix
#    search below.
alias_target=""
if [ -f "$aliases" ]; then
    alias_target="$(awk -F'\t' -v n="$lc" '
        $1 == n { print $2; exit }
    ' "$aliases")"
fi

if [ -n "$alias_target" ]; then
    case "$alias_target" in
        *-*)
            # Direct glyph-name reference.
            char="$(awk -F'\t' -v k="$alias_target" '$1==k{print $2; exit}' "$db")"
            ;;
        *)
            lc="$alias_target"
            char=""
            ;;
    esac
else
    char=""
fi

# 2) Prefix search across icon sets, if no direct alias hit yet.
#    Priority favors thin/monoline styles (Codicons, Material, Octicons)
#    over heavier brand-style sets so window icons share a consistent
#    weight.
if [ -z "$char" ]; then
    char="$(awk -F'\t' -v n="$lc" '
        $1 == n            && !x { x = $2 }
        $1 == "cod-" n     && !c { c = $2 }
        $1 == "md-" n      && !m { m = $2 }
        $1 == "oct-" n     && !o { o = $2 }
        $1 == "dev-" n     && !d { d = $2 }
        $1 == "fa-" n      && !f { f = $2 }
        $1 == "seti-" n    && !s { s = $2 }
        $1 == "custom-" n  && !u { u = $2 }
        END {
            if (x)      print x
            else if (c) print c
            else if (m) print m
            else if (o) print o
            else if (d) print d
            else if (f) print f
            else if (s) print s
            else if (u) print u
        }
    ' "$db")"
fi

[ -n "$char" ] || char="$fallback"
printf '%s' "$char" | tee "$cache"
