{
  "mcp": {
    "toolMode": "proxy",
    "startup": "lazy",
    "executor": {
      "type": "remote",
      "url": "https://executor-cloudflare.rahulage.workers.dev/mcp"
    },
    "open-computer-use": {
      "type": "local",
      "command": ["open-computer-use", "mcp"],
      "enabled": true,
      "timeout": 60000
    }
  }
}
