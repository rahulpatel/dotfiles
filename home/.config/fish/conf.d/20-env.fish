set fish_greeting

set -gx EDITOR nvim
set -gx MANPAGER 'nvim +Man!'

# Resolve the checkout through the deployed config symlink, regardless of DEST.
set -l conf_dir (path dirname (path resolve (status filename)))
set -gx DOTFILES_DIR (path resolve "$conf_dir/../../../..")

# Machine-specific settings generated by mise bootstrap.
if test -f "$HOME/.local/share/dotfiles/env.fish"
    source "$HOME/.local/share/dotfiles/env.fish"
end
