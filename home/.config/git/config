[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

# Machine-local overrides (not committed). Restored out-of-band per machine.
# Put work routing and identity here so employer details never enter the repo:
#
#   [includeIf "hasconfig:remote.*.url:git@github.com:<employer-org>/**"]
#       path = ./config.work
#   [includeIf "gitdir:~/work/"]
#       path = ./config.work
#
# ...and keep the work identity itself in ./config.work, also out-of-band.
[include]
	path = ./.config.local
