#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGES_DIR="$DOTFILES_DIR/packages"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
PROFILE_FILE="$STATE_DIR/profile"

usage() {
  cat <<'EOF'
Usage:
  dot install <profile>
  dot update [profile]
  dot uninstall
  dot macos
  dot stow
  dot unstow
  dot doctor [profile]
  dot profiles
  dot help

Profiles are Brewfiles in ./packages. The base profile is always installed
before the selected profile and is never saved as the active profile.
EOF
}

log() { printf '\033[1;34m[dot]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[dot]\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[1;31m[dot]\033[0m %s\n' "$*" >&2
  exit 1
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

ensure_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "This installer only supports macOS."
}

ensure_xcode_tools() {
  if xcode-select -p >/dev/null 2>&1; then
    return
  fi

  log "Installing Xcode Command Line Tools. Complete the GUI prompt to continue."
  xcode-select --install || true
  until xcode-select -p >/dev/null 2>&1; do
    sleep 10
  done
}

ensure_homebrew() {
  if command_exists brew; then
    return
  fi

  log "Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi

  command_exists brew || die "Homebrew installed, but brew is not available in PATH."
}

profile_path() {
  printf '%s/%s\n' "$PACKAGES_DIR" "$1"
}

validate_profile() {
  local profile="$1"

  [ -n "$profile" ] || die "Profile is required. Run 'dot profiles' to list profiles."
  [ "$profile" != "base" ] || die "base is installed automatically and cannot be selected as a profile."
  [ -f "$(profile_path "$profile")" ] || die "Unknown profile '$profile'. Run 'dot profiles' to list profiles."
}

saved_profile() {
  [ -f "$PROFILE_FILE" ] || return 1
  read -r profile <"$PROFILE_FILE"
  [ -n "${profile:-}" ] || return 1
  printf '%s\n' "$profile"
}

resolve_profile() {
  local profile="${1:-}"

  if [ -z "$profile" ]; then
    profile="$(saved_profile)" || die "No profile provided and no saved profile exists. Run 'dot install <profile>'."
  fi

  validate_profile "$profile"
  printf '%s\n' "$profile"
}

save_profile() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" >"$PROFILE_FILE"
}

brew_bundle() {
  local file="$1"

  [ -f "$file" ] || die "Missing Brewfile: $file"
  log "Installing $(basename "$file") packages"
  brew bundle --file "$file"
}

stow_home() {
  log "Stowing home files"
  stow --dir "$DOTFILES_DIR" --target "$HOME" --restow home
}

unstow_home() {
  log "Unstowing home files"
  stow --dir "$DOTFILES_DIR" --target "$HOME" --delete home
}

set_default_shell_to_fish() {
  local fish_path current_shell

  fish_path="$(command -v fish || true)"
  [ -n "$fish_path" ] || die "fish is not available after package installation."

  current_shell="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null || true)"
  current_shell="${current_shell#UserShell: }"
  if [ "$current_shell" = "$fish_path" ]; then
    log "Default shell is already fish"
    return
  fi

  if ! grep -Fxq "$fish_path" /etc/shells; then
    log "Adding $fish_path to /etc/shells"
    printf '%s\n' "$fish_path" | sudo tee -a /etc/shells >/dev/null
  fi

  log "Changing default shell to fish"
  chsh -s "$fish_path"
}

create_developer_dir() {
  mkdir -p "$HOME/Developer"
}

ensure_mise_tools() {
  command_exists mise || die "mise is required. Install it or run 'dot install <profile>' first."
  log "Installing mise tools"
  mise install
}

ensure_herdr_integrations() {
  command_exists herdr || die "herdr is required. Install it or run 'dot install <profile>' first."
  log "Installing/updating Herdr's Pi integration"
  herdr integration install pi
}

sync_skills() {
  local lock_file="$HOME/.agents/.skill-lock.json"
  local temp_lock="$HOME/skills-lock.json"

  [ -f "$lock_file" ] || {
    warn "Skipping skills because $lock_file is missing."
    return
  }

  [ ! -e "$temp_lock" ] || die "$temp_lock already exists. Move it before running dot."

  log "Installing/updating skills"
  (
    trap 'rm -f "$temp_lock"' EXIT
    cp "$lock_file" "$temp_lock"
    cd "$HOME"
    mise exec -- npx skills experimental_install
  )
}

install_packages() {
  local profile="$1"

  brew_bundle "$(profile_path base)"
  brew_bundle "$(profile_path "$profile")"
}

configure_macos() {
  log "Applying macOS preferences"
  "$DOTFILES_DIR/macos"
}

cmd_macos() {
  ensure_macos
  configure_macos
}

cmd_install() {
  local profile
  profile="${1:-}"
  validate_profile "$profile"

  ensure_macos
  ensure_xcode_tools
  ensure_homebrew
  install_packages "$profile"
  configure_macos
  set_default_shell_to_fish
  stow_home
  ensure_mise_tools
  ensure_herdr_integrations
  sync_skills
  save_profile "$profile"
  create_developer_dir
  log "Installed profile '$profile'."
}

cmd_update() {
  local profile
  profile="$(resolve_profile "${1:-}")"

  ensure_macos
  ensure_xcode_tools
  ensure_homebrew

  if [ -d "$DOTFILES_DIR/.git" ]; then
    log "Pulling latest dotfiles"
    git -C "$DOTFILES_DIR" pull --ff-only
  else
    warn "Skipping git pull because $DOTFILES_DIR is not a git repo."
  fi

  log "Updating Homebrew"
  brew update
  install_packages "$profile"
  configure_macos
  stow_home
  ensure_mise_tools
  ensure_herdr_integrations
  sync_skills
  save_profile "$profile"
  log "Updated profile '$profile'."
}

cmd_stow() {
  command_exists stow || die "stow is required. Install it or run 'dot install <profile>' first."
  stow_home
}

cmd_unstow() {
  command_exists stow || die "stow is required. Install it or run 'dot install <profile>' first."
  unstow_home
}

cmd_uninstall() {
  cmd_unstow
  log "Uninstalled Stow-managed home files. Homebrew packages were left untouched."
}

cmd_doctor() {
  local profile="${1:-}"
  local ok=1

  if [ -n "$profile" ]; then
    validate_profile "$profile"
  elif ! profile="$(saved_profile)"; then
    warn "No saved profile found."
    profile=""
    ok=0
  elif ! validate_profile "$profile"; then
    ok=0
  fi

  [ "$(uname -s)" = "Darwin" ] || {
    warn "Not running macOS."
    ok=0
  }
  xcode-select -p >/dev/null 2>&1 || {
    warn "Xcode Command Line Tools are missing."
    ok=0
  }
  command_exists brew || {
    warn "Homebrew is missing."
    ok=0
  }
  command_exists stow || {
    warn "GNU Stow is missing."
    ok=0
  }
  [ -f "$(profile_path base)" ] || {
    warn "Missing packages/base."
    ok=0
  }
  [ -z "$profile" ] || [ -f "$(profile_path "$profile")" ] || {
    warn "Missing packages/$profile."
    ok=0
  }

  if command_exists stow; then
    stow --dir "$DOTFILES_DIR" --target "$HOME" --restow --simulate home >/dev/null || {
      warn "Stow reported conflicts. Run the command above without --simulate for details."
      ok=0
    }
  fi

  if [ "$ok" -eq 1 ]; then
    log "Doctor passed${profile:+ for profile '$profile'}."
  else
    die "Doctor found issues."
  fi
}

cmd_profiles() {
  local file name

  [ -d "$PACKAGES_DIR" ] || die "Missing packages directory: $PACKAGES_DIR"

  for file in "$PACKAGES_DIR"/*; do
    [ -f "$file" ] || continue
    name="$(basename "$file")"
    [ "$name" = "base" ] && continue
    printf '%s\n' "$name"
  done
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
  install) cmd_install "$@" ;;
  update) cmd_update "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  macos) cmd_macos "$@" ;;
  stow) cmd_stow "$@" ;;
  unstow) cmd_unstow "$@" ;;
  doctor) cmd_doctor "$@" ;;
  profiles) cmd_profiles ;;
  help | --help | -h) usage ;;
  *)
    usage >&2
    die "Unknown command: $command"
    ;;
  esac
}

main "$@"
