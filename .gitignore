*.local
!home/.local/
*.work

# Machine-local mise config (profile selection, overrides)
.miserc.local.toml
mise.local.toml
mise.*.local.toml

# Only git-tracked files under home/ are linked into $HOME (manifest = "git"),
# so apps no longer write state into this repo. These stay as a safety net.

# Machine-local credentials and session data
home/.config/herdr/*.log
home/.config/herdr/session.json
home/.config/gh/
home/.config/opencode/service.json
home/.agents/pstack-models.md
home/.pi/agent/*auth.json
home/.pi/agent/sessions/
home/.pi/agent/trust.json

# Generated and machine-local application state
home/.config/containers/
home/.config/fish/fish_variables
home/.config/herdr/.plugins.lock
home/.config/herdr/plugins/
home/.config/herdr/plugins.json
home/.config/herdr/release-notes.json
home/.local/bin/python3.12
home/.config/nvim/lazy-lock.json
home/.config/opencode/agents/comment-sicko.md
home/.config/opencode/agents/poteto-agent.md
home/.pi/agent/agents/comment-sicko.md
home/.pi/agent/agents/poteto-agent.md
home/.config/nvim/lazyvim.json
home/.config/vite-plus/
home/.pi/agent/bin/
home/.pi/agent/git/
home/.pi/agent/npm/
home/.pi/agent/models-store.json
home/.pi/agent/extensions/herdr-agent-state.ts
